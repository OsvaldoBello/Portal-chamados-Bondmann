# Segredos — NUNCA commitar (Seção 6.2: chaves só em env vars)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / Tailwind
node_modules/

# Build de CSS gerado pelo Tailwind CLI
app/static/css/app.css

# Supabase CLI local
supabase/.branches/
supabase/.temp/

# OS
.DS_Store
*.log

# Documentos de origem em Word — citados pelo nome nos MDs (plano mestre/plano de
# melhorias), não versionados (mesmo precedente do docx de spec v2.0).
*.docx
~$*

# Claude Agent Workspace
.claude/

# graphify — cache/derived e config de máquina local (não versionar; graph.json,
# GRAPH_REPORT.md, graph.html e manifest.json permanecem versionados)
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_ast.json
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_incremental.json
graphify-out/.graphify_uncached.txt
graphify-out/converted/
docs/graphify-out/cache/

