# Variáveis novas da migração para WUZAPI (docs/wuzapi/) — acrescentar ao
# .env do portal. As da Meta continuam existindo: o rollback é trocar
# WHATSAPP_PROVIDER de volta para `meta`, sem redeploy de código.

# --- Seleção de provedor ----------------------------------------------------
# meta | wuzapi
WHATSAPP_PROVIDER=meta

# --- WUZAPI -----------------------------------------------------------------
# URL interna do container (NUNCA um endereço público).
WUZAPI_BASE_URL=http://wuzapi:8080
# Token do usuário criado em POST /admin/users — é o header `Token:` de todas
# as chamadas de runtime. Gere com: openssl rand -hex 24
WUZAPI_TOKEN=
# Token de admin do wuzapi (só para criar/remover usuário e trocar webhook;
# o portal não usa em runtime). openssl rand -hex 24
WUZAPI_ADMIN_TOKEN=
# Chave HMAC dos webhooks, >= 32 caracteres. openssl rand -hex 32
WUZAPI_WEBHOOK_HMAC_KEY=
# Chave de criptografia interna do wuzapi (32 bytes). openssl rand -hex 32
WUZAPI_ENCRYPTION_KEY=
# Timeout padrão das chamadas HTTP ao wuzapi (segundos).
WUZAPI_TIMEOUT_S=15

# --- Humanização da resposta do bot ----------------------------------------
# Faixa do atraso de "digitando…" antes de cada mensagem do intake.
WHATSAPP_DIGITACAO_MIN_S=1.0
WHATSAPP_DIGITACAO_MAX_S=2.5

# --- Fila de notificações ativas -------------------------------------------
WHATSAPP_NOTIFICACAO_ATIVA=false
# Intervalo mínimo entre DUAS notificações quaisquer + jitter aleatório.
WHATSAPP_NOTIFICACAO_INTERVALO_MIN_S=2.0
WHATSAPP_NOTIFICACAO_JITTER_S=3.0
# Intervalo mínimo entre duas notificações para o MESMO número.
WHATSAPP_NOTIFICACAO_INTERVALO_CONTATO_S=120
# Janela de envio (hora local de São Paulo). Fora dela, a fila espera.
WHATSAPP_NOTIFICACAO_HORA_INICIO=7
WHATSAPP_NOTIFICACAO_HORA_FIM=21
