# Portal de Chamados Bondmann — exemplo de configuração.
# Copie para `.env` (NUNCA commitado) e preencha com valores reais.
# REGRA DURA (Seção 6.2): nenhuma chave real pode entrar em arquivo versionado.

# --- Ambiente ---
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# --- Supabase ---
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_ANON_KEY=<sua-anon-key>
# Usada SOMENTE em tarefas administrativas/auditadas; NUNCA chega ao browser.
SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>

# Verificação de JWT (Seção 3.6): com JWKS assimétrico não é necessário segredo.
# Preencha apenas se o projeto usar HS256 legado.
SUPABASE_JWT_SECRET=

# --- Banco (asyncpg via Supavisor) ---
# Transaction mode (porta 6543) para o pool da aplicação (Seção 2.1).
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- Segredos de aplicação (gerar aleatórios, ex.: `openssl rand -hex 32`) ---
SESSION_SECRET=<hex-aleatorio-32-bytes>
CSRF_SECRET=<hex-aleatorio-32-bytes>

# --- Cookies ---
COOKIE_SECURE=true               # false apenas em dev sem HTTPS

# --- WhatsApp Cloud API (Meta) ---
# Token arbitrário que você escolhe e cola em "Verificar token" no painel da Meta.
WHATSAPP_VERIFY_TOKEN=<gerar-string-aleatoria>
# App Secret do app da Meta (aba Configurações Básicas), usado para validar a
# assinatura HMAC dos eventos recebidos no webhook.
WHATSAPP_APP_SECRET=

# --- Diagnóstico (/health/ready, /health/config e /metrics) ---
# Exigido em produção (header X-Diagnostics-Token); sem ele as rotas ficam
# negadas por padrão em produção. Gerar aleatório, ex.: `openssl rand -hex 16`.
DIAGNOSTICS_TOKEN=

# --- Observabilidade (Sprint 2 / item 2.6) ---
# DSN do projeto Sentry (ou compatível). Vazia = integração desligada (nenhuma
# chamada a sentry_sdk.init(), captura de exceção vira no-op).
SENTRY_DSN=
# Fração de requisições com tracing de performance (0.0–1.0). 0 = só erros
# (recomendado para começar; tracing tem custo de armazenamento no Sentry).
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- IA: triagem de chamados + resumo do Químico (plano_md_mestre_IA.md) ---
# Provedor compatível com o formato OpenAI (/chat/completions). Decisão C5
# (2026-07-22): OpenAI / gpt-5.4-mini. Chave VAZIA = toda IA desligada (triagem
# e resumo); chamados são abertos normalmente sem IA. Os nomes antigos GROQ_*
# ainda são aceitos como fallback (transição), mas estão deprecados.
IA_TRIAGEM_API_KEY=
IA_TRIAGEM_MODEL=gpt-5.4-mini
IA_TRIAGEM_BASE_URL=https://api.openai.com/v1
# Kill switch geral da triagem (false = nenhum agente roda, nem em sombra).
IA_TRIAGEM_ATIVA=false
# CSV de departamentos com triagem (ex.: "TI" ou "TI,Dpto Químico"). Vazio = nenhum.
IA_TRIAGEM_DEPARTAMENTOS=
# Modo sombra: só notas internas; sem perguntas públicas/e-mail (modo da F1).
# false = ninguém em sombra (estado final F6).
IA_TRIAGEM_MODO_SOMBRA=true
# Saída da sombra POR DEPARTAMENTO (F2): CSV liberado para perguntas públicas
# mesmo com a sombra global ligada (ex.: "TI"). Vazio = ninguém sai da sombra.
IA_TRIAGEM_PERGUNTAS_DEPARTAMENTOS=
# Confiança mínima para perguntar ao autor (BAIXA/MEDIA/ALTA). Default BAIXA
# (decisão 2026-07-24); ALTA restaura a guarda antiga. Inválido = ALTA.
IA_TRIAGEM_PERGUNTAS_CONFIANCA_MINIMA=BAIXA
# Modelo opcional do Passe B do Químico (F4); vazio = usa IA_TRIAGEM_MODEL.
IA_TRIAGEM_MODEL_PASSE_B=
# Timeout por passe, em segundos (C6).
IA_TRIAGEM_TIMEOUT_S=30
# Teto de rodadas de perguntas ao usuário.
IA_TRIAGEM_MAX_RODADAS=2
# Conexão do role Postgres `ia_worker` (C7) — obrigatória só para o Químico (F4).
IA_WORKER_DATABASE_URL=
# Intervalo (segundos) da varredura de reconciliação de triagens perdidas por
# restart/redeploy (o agendamento via asyncio.create_task não é durável). 0 = desliga.
# 60 desde 2026-07-29 (era 300): com a margem de órfão de 1 min, o pior caso de
# recuperação fica em ~2 min, dentro da meta p95 (investigação do BOND-2026-00629).
IA_TRIAGEM_RECONCILIACAO_INTERVALO_S=60

# --- Leitura de anexos (imagem/documento) pela triagem ---
# Kill switch estreito e independente do geral: false = nenhum anexo é lido
# (nem baixado), mesmo com IA_TRIAGEM_ATIVA=true.
IA_TRIAGEM_ANEXOS_ATIVO=false
# Tetos por tipo de arquivo processado por chamado. "Documento" cobre PDF,
# Word, Excel e PowerPoint (mesmo perfil de custo: texto extraído).
IA_TRIAGEM_ANEXOS_MAX_ARQUIVOS_IMAGEM=2
IA_TRIAGEM_ANEXOS_MAX_ARQUIVOS_DOCUMENTO=2
# Teto de bytes por arquivo LIDO pela IA (independente do limite de upload) —
# Químico igual ao teto de upload (100MB — laudos/fotos de análise).
IA_TRIAGEM_ANEXOS_MAX_BYTES=8388608
IA_TRIAGEM_ANEXOS_MAX_BYTES_QUIMICO=104857600
# Redimensionamento de imagem antes do envio (maior lado, px) e qualidade JPEG.
IA_TRIAGEM_ANEXOS_MAX_DIMENSAO_PX=1024
IA_TRIAGEM_ANEXOS_QUALIDADE_JPEG=78
# Nível de detalhe de imagem enviado ao modelo (auto/low/high) — controla
# custo em tokens. Inválido degrada para "low".
IA_TRIAGEM_ANEXOS_DETAIL=low
# Extração de texto de documento (PDF/Word/Excel/PowerPoint): páginas de PDF
# e caracteres por arquivo (sem OCR).
IA_TRIAGEM_ANEXOS_PDF_MAX_PAGINAS=5
IA_TRIAGEM_ANEXOS_DOCUMENTO_MAX_CHARS=6000
