{
  "name": "portal-chamados-bondmann",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de Chamados Bondmann Química — frontend assets (Tailwind CLI build, Seção 0.4 / C3) e protótipos de referência",
  "scripts": {
    "build:css": "tailwindcss -i ./app/static/src/input.css -o ./app/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./app/static/src/input.css -o ./app/static/css/app.css --watch",
    "proto:build:html": "python3 prototipos/build.py",
    "proto:build:css": "tailwindcss -c prototipos/tailwind.config.js -i prototipos/src.css -o prototipos/assets/app.css --minify",
    "proto:build": "npm run proto:build:html && npm run proto:build:css",
    "proto:serve": "python3 -m http.server 8000 --directory prototipos"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:41729/git/OsvaldoBello/Portal-chamados-Bondmann"
  },
  "license": "ISC",
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@alpinejs/csp": "3.14.8",
    "@supabase/supabase-js": "2.47.10",
    "alpinejs": "^3.14.1",
    "chart.js": "4.4.1",
    "htmx.org": "2.0.4",
    "sortablejs": "1.15.6"
  }
}
